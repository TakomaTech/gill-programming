{
  "name": "gill-language-support",
  "displayName": "Gill Language Support",
  "publisher": "PointDev",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icons/gill128x128.png",
  "activationEvents": [
   
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.104.0",
    "typescript": "^5.5.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "gill.openWelcome",
        "title": "Gill: Open Welcome"
      }
    ],
    "languages": [
      {
        "id": "gill",
        "aliases": ["Gill", "gill"],
        "extensions": [".gill"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gill",
        "scopeName": "source.gill",
        "path": "./syntaxes/gill.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gill",
        "path": "./snippets/gill.code-snippets"
      }
    ]
  }
}
